class Node{
    constructor(val){
        this.val = val;
        this.next = null;
    }
}

class SinglyLinkedList{
    constructor(){
        this.length = 0;
        this.head = null;
        this.tail = null;
    }
    // Pushing the node to the end
    push(val){
        var temp = new Node(val)
           if(!this.head){
               this.head = temp
               this.tail = temp
               
           }else{
               this.tail.next = temp
               this.tail = temp
               
           }
        this.length++
        return this;
    }

    // Traversing through the list
    traverse(){
        var current = this.head;
        while(current){
            console.log(current.val);
            current = current.next
        }
    }

    // removing from the tail
    pop(){
       if(!this.head) return undefined;
        var current = this.head
        var newTail = current;
        while(current.next){
            newTail = current;
            current = current.next
        }
        this.tail = newTail;
        this.tail.next = null;
        this.length--;
        if(this.length === 0){
            this.head = null;
            this.tail = null;
        }
        return current
    }
    // removing from the head
    shift(){
        if(!this.head) return undefined;
        var current = this.head
        this.head = current.next;
        this.length--
        return current
    }
    // Inserting at the head
    unshift(val){
        let newNode = new Node(val)
        if(!this.head){
            this.head = newNode;
            this.tail = newNode;
        }else{
            newNode.next = this.head;
            this.head = newNode
        }
        this.length++
        return this
    }

    // Getting a node at a specific index:
    getNode(val){
        if (val >= this.length || val <0) return null
        let cnt =0;
        let current = this.head
        while (cnt !== val){
            current = current.next
            cnt++
        }
        return current
    }

    // Set a node at a specific position:
    setNode(val,ind){
        let nodePoint = this.getNode(ind);
        if(nodePoint){
            nodePoint.val = val;
            return true
        }
        return false
    }

    insert(val,ind){
        let newNode = new Node(val)
        if(ind <0 || ind > this.length) return false
        if(ind === this.length) this.push(val);
        if(ind === 0 ) this.unshift(val)
        else{
            let getIndex = this.getNode(ind-1)
            newNode.next = getIndex.next
            getIndex.next = newNode
            this.length++
            return true
        }
        return false
    }
}

